<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FluentBrowserSample.ViewModels"
             xmlns:views="clr-namespace:FluentBrowserSample.Views"
             x:Class="FluentBrowserSample.MainPage" x:DataType="vm:CardStudioViewModel"
             AutomationId="main-page" BackgroundColor="{DynamicResource Fluent.CanvasColor}">
    <ScrollView AutomationId="page-scroll">
        <VerticalStackLayout x:Name="PageContent" Padding="28,36" Spacing="28" MaximumWidthRequest="1040"
                             HorizontalOptions="Center">
            <Grid x:Name="HeaderGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto"
                  ColumnSpacing="24" RowSpacing="12" AutomationId="page-header">
                <VerticalStackLayout Spacing="4" VerticalOptions="Start">
                    <Label Text="MAUI LABS / FLUENT WEB COMPONENTS" Style="{StaticResource HeaderEyebrow}" />
                    <Label Text="Experimental browser backend" Style="{StaticResource Metadata}" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="ThemeSelector" Grid.Row="1" Spacing="8"
                                     HorizontalOptions="End" VerticalOptions="Start">
                    <Grid x:Name="ThemeButtons" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Button x:Name="SystemThemeButton" Text="System" Clicked="OnSystemThemeClicked" AutomationId="theme-system" />
                        <Button x:Name="LightThemeButton" Grid.Column="1" Text="Light" Clicked="OnLightThemeClicked" AutomationId="theme-light" />
                        <Button x:Name="DarkThemeButton" Grid.Column="2" Text="Dark" Clicked="OnDarkThemeClicked" AutomationId="theme-dark" />
                    </Grid>
                    <Label x:Name="ThemeStatusLabel" Style="{StaticResource Metadata}" AutomationId="theme-status"
                           HorizontalTextAlignment="End" />
                </VerticalStackLayout>
            </Grid>
            <VerticalStackLayout Spacing="14">
                  <Label Text="Your XAML. A new horizon." Style="{StaticResource PageTitle}" />
                  <Label Text="A .NET MAUI app, running in your browser." Style="{StaticResource Lead}" />
                <Label Text="Keep the application model you know. MAUI owns the layout, Fluent supplies real web controls, and NativeAOT compiles your C# to WebAssembly. This page is the example — not a screenshot of one."
                       Style="{StaticResource MutedBody}" />
                <Grid x:Name="TechnologyGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Style="{StaticResource IntroCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="XAML + C#" Style="{StaticResource CardTitle}" />
                            <Label Text="Source-generated views, typed bindings and ordinary .NET services." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource IntroCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="MAUI layout" Style="{StaticResource CardTitle}" />
                            <Label Text="Measure and arrange stay in MAUI. Resize this page to see its Grid adapt." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource IntroCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Fluent controls" Style="{StaticResource CardTitle}" />
                            <Label Text="Real web components, browser text input and a shared light/dark palette." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource IntroCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="NativeAOT" Style="{StaticResource CardTitle}" />
                            <Label Text="LLVM compiles .NET to Wasm. Publish the files to a static web server." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
            <Label Text="Try it out" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource PanelCard}">
                <VerticalStackLayout Spacing="20">
                    <Label Text="Demo - Make a card" Style="{StaticResource PanelTitle}" />
                    <Label Text="Edit text, choose artwork and compare fonts. Try a preset to update the MAUI controls from C#, then make it your own."
                           Style="{StaticResource MutedBody}" />
                    <Grid x:Name="EditorGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto" ColumnSpacing="28" RowSpacing="24">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="CARD EDITOR" Style="{StaticResource Eyebrow}" />
                            <Label Text="Title" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="TitleEntry" Text="{Binding Title, Mode=TwoWay}"
                                   Placeholder="Give your card a title" MaxLength="64"
                                   ReturnType="Done" Completed="OnEntryCompleted" AutomationId="card-title-input"
                                   SemanticProperties.Description="Card title" />
                            <Label Text="Tagline" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Tagline, Mode=TwoWay}" Placeholder="Add a little personality"
                                   MaxLength="100" ReturnType="Done" Completed="OnEntryCompleted"
                                   AutomationId="card-tagline-input" SemanticProperties.Description="Card tagline" />
                            <Label Text="Artwork" Style="{StaticResource FieldLabel}" />
                            <!-- TODO: Replace these explicit choices with a Picker when its browser handler is available. -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text=".NET 10" Command="{Binding SelectRasterCommand, Mode=OneWay}" AutomationId="artwork-raster">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsRasterArtwork, Mode=OneWay}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DotNetBrandColor}, Dark={StaticResource DotNetBrandDarkColor}}" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark=Black}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Grid.Column="1" Text=".NET bot" Command="{Binding SelectVectorCommand, Mode=OneWay}" AutomationId="artwork-vector">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsVectorArtwork, Mode=OneWay}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DotNetBrandColor}, Dark={StaticResource DotNetBrandDarkColor}}" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark=Black}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                            <Label Text="{Binding ArtworkDescription, Mode=OneWay}" Style="{StaticResource Hint}" AutomationId="artwork-choice" />
                            <Label Text="Font" Style="{StaticResource FieldLabel}" />
                            <!-- TODO: Replace the stateful Button with a native toggle when supported by the backend. -->
                            <Button Text="{Binding FontToggleText, Mode=OneWay}" Command="{Binding ToggleFontCommand, Mode=OneWay}"
                                    HorizontalOptions="Start" AutomationId="font-toggle">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding UseCustomFont, Mode=OneWay}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DotNetBrandColor}, Dark={StaticResource DotNetBrandDarkColor}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark=Black}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="Try a preset" Command="{Binding NextPresetCommand, Mode=OneWay}" Clicked="OnPresetClicked" AutomationId="preset-next" />
                                <Button Grid.Column="1" Text="Reset" Command="{Binding ResetCommand, Mode=OneWay}" AutomationId="draft-reset" />
                            </Grid>
                            <Label Text="{Binding DraftHint, Mode=OneWay}" Style="{StaticResource Hint}"
                                   AutomationId="draft-hint" />
                        </VerticalStackLayout>
                        <Border x:Name="DraftPreview" Grid.Row="1" Style="{StaticResource PreviewCard}" AutomationId="draft-preview">
                            <VerticalStackLayout Spacing="14" VerticalOptions="Center">
                                <Label Text="LIVE PREVIEW" Style="{StaticResource Eyebrow}" HorizontalTextAlignment="Center" />
                                <Image Source="{Binding Artwork, Mode=OneWay}" WidthRequest="144" HeightRequest="160" Aspect="AspectFit"
                                       HorizontalOptions="Center" SemanticProperties.Description="The .NET bot" AutomationId="draft-artwork" />
                                <Label Text="{Binding Title, Mode=OneWay}" Style="{StaticResource PreviewTitle}" FontFamily="{Binding FontFamily, Mode=OneWay}"
                                       HorizontalTextAlignment="Center" AutomationId="card-title-preview" />
                                <Label Text="{Binding Tagline, Mode=OneWay}" FontFamily="{Binding FontFamily, Mode=OneWay}" HorizontalTextAlignment="Center"
                                        Style="{StaticResource MutedBody}" AutomationId="card-tagline-preview" />
                                    <Label Text=".NET + MAUI + Fluent" Style="{StaticResource BrandMetadata}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <Button Text="Add card" Command="{Binding AddCardCommand, Mode=OneWay}"
                            HorizontalOptions="Start" AutomationId="card-add" />
                      <Label Text="Your cards" Style="{StaticResource PanelTitle}" />
                    <Label Text="Added cards keep their text, artwork and font. Add at least two to try reordering and playback. Editing the preview does not change these copies."
                           Style="{StaticResource MutedBody}" />
                      <Label Text="{Binding BoardSummary, Mode=OneWay}" Style="{StaticResource FieldLabel}" AutomationId="board-summary" />
                    <views:ArrangedStackLayout x:Name="BoardItems" Spacing="8" AutomationId="board-items" />
                      <Label Text="{Binding BoardMessage, Mode=OneWay}" Style="{StaticResource Caption}"
                           AutomationId="board-message" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Move first" Command="{Binding MoveFirstCommand, Mode=OneWay}" AutomationId="board-move" />
                        <Button Text="Remove last" Command="{Binding RemoveLastCommand, Mode=OneWay}" AutomationId="board-remove" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Play cards" Clicked="OnPlayClicked" IsEnabled="{Binding CanPlay, Mode=OneWay}" AutomationId="board-play" />
                        <Button x:Name="StopPlaybackButton" Text="Stop" Clicked="OnStopClicked" IsEnabled="False" AutomationId="board-stop" />
                    </HorizontalStackLayout>
                    <Label x:Name="PlaybackStatusLabel" Text="Playback is off. Motion starts only when you choose Play."
                           Style="{StaticResource Hint}" AutomationId="playback-status" />
                    <Label Text="UNDER THE SURFACE" Style="{StaticResource Eyebrow}" />
                    <Label Text="The editor and preview share a ViewModel through two-way XAML bindings. Commands update the state, and DI supplies the presets. Standard MauiImage and MauiFont declarations package the artwork and Open Sans."
                           Style="{StaticResource Caption}" />
                    <Label Text="An observable collection holds your cards. MAUI views follow its changes and update the browser layout. Playback uses a dispatcher timer and MAUI opacity animations. It waits for the reordered cards to finish layout before fading them in."
                           Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout Spacing="14">
                <Label Text="Performance metrics of this page" Style="{StaticResource SectionTitle}" />
                <Grid x:Name="MetricsGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                    <Border Style="{StaticResource PanelCard}" AutomationId="startup-metric-card">
                        <VerticalStackLayout Spacing="8">
                            <Label x:Name="StartupLabel" Text="Startup: measuring…" Style="{StaticResource PanelTitle}" AutomationId="startup-time" />
                            <Label Text="Navigation to the first MAUI frame opportunity, including download and runtime initialization. Network, cache and background tabs affect this measurement."
                                   Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border x:Name="WasmMetricCard" Grid.Row="1" Style="{StaticResource PanelCard}" AutomationId="wasm-metric-card">
                        <VerticalStackLayout Spacing="8">
                            <Label x:Name="WasmSizeLabel" Text="Wasm Size: measuring…" Style="{StaticResource PanelTitle}" AutomationId="wasm-size" />
                            <Label Text="Decoded module size before HTTP compression. This is not transferred bytes, total page weight or runtime memory. Gzip or Brotli can reduce the download."
                                   Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
            <Border Style="{StaticResource Divider}" />
            <VerticalStackLayout Spacing="12">
                <!-- TODO: Make README an inline hyperlink when Label supports links. -->
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Explore source ↗" Clicked="OnRepositoryClicked" AutomationId="repository-link" />
                    <Button Text="README ↗" Clicked="OnReadmeClicked" AutomationId="readme-link" />
                </HorizontalStackLayout>
                <Label Text="Experimental, not full MAUI parity yet. See README for supported controls and current limitations."
                       Style="{StaticResource Hint}" />
                <Label Text="Artwork: .NET bot SVG (CC0), MAUI template PNG (MIT). Font: Open Sans (Apache 2.0). Notices are included with the packaged assets."
                       Style="{StaticResource Metadata}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>