<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FluentBrowserSample.MainPage"
             AutomationId="main-page"
             BackgroundColor="{DynamicResource Fluent.CanvasColor}">
    <ScrollView AutomationId="page-scroll">
        <VerticalStackLayout Padding="28,36" Spacing="24" MaximumWidthRequest="1040"
                             HorizontalOptions="Center">
            <Grid x:Name="HeaderGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto"
                  ColumnSpacing="24" RowSpacing="12" AutomationId="page-header">
                <VerticalStackLayout Spacing="4" VerticalOptions="Start" AutomationId="header-title">
                    <Label Text="MAUI LABS / FLUENT WEB COMPONENTS" FontSize="12" FontAttributes="Bold"
                              TextColor="{DynamicResource Fluent.MutedColor}" />
                    <Label Text="Experimental backend preview" FontSize="12"
                              TextColor="{DynamicResource Fluent.MutedColor}" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="ThemeSelector" Grid.Row="1" Spacing="8"
                                     HorizontalOptions="End" VerticalOptions="Start" AutomationId="theme-selector">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="System" Clicked="OnSystemThemeClicked" AutomationId="theme-system" />
                        <Button Text="Light" Clicked="OnLightThemeClicked" AutomationId="theme-light" />
                        <Button Text="Dark" Clicked="OnDarkThemeClicked" AutomationId="theme-dark" />
                    </HorizontalStackLayout>
                    <Label x:Name="ThemeStatusLabel" FontSize="12" AutomationId="theme-status"
                           HorizontalTextAlignment="End"
                              TextColor="{DynamicResource Fluent.MutedColor}" />
                </VerticalStackLayout>
            </Grid>
            <VerticalStackLayout Spacing="12">
                <Label Text="Written in XAML.&#10;Running in your browser." FontSize="40" FontAttributes="Bold"
                      TextColor="{DynamicResource Fluent.BrandForegroundColor}" />
                <Label Text="A familiar way to build something new. This entire page is a MAUI app — compiled to WebAssembly, rendered with native web elements."
                      TextColor="{DynamicResource Fluent.MutedColor}" />
            </VerticalStackLayout>

                        <Grid x:Name="TechnologyGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                    ColumnSpacing="12" RowSpacing="12">
                                <Border Padding="18" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="XAML" FontSize="22" FontAttributes="Bold" />
                           <Label Text="Defines the page" FontSize="13"
                               TextColor="{DynamicResource Fluent.MutedColor}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="18" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="MAUI" FontSize="22" FontAttributes="Bold" />
                           <Label Text="Owns layout and events" FontSize="13"
                               TextColor="{DynamicResource Fluent.MutedColor}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Padding="18" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Fluent" FontSize="22" FontAttributes="Bold" />
                           <Label Text="Draws real web controls" FontSize="13"
                               TextColor="{DynamicResource Fluent.MutedColor}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="18"
                    StrokeShape="RoundRectangle 12" AutomationId="nativeaot-card">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="NativeAOT" FontSize="22" FontAttributes="Bold" />
                           <Label Text="LLVM compilation to WebAssembly" FontSize="13"
                               TextColor="{DynamicResource Fluent.MutedColor}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

                <Border Padding="24" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="18">
                    <HorizontalStackLayout Spacing="0">
                        <Label Text="Events stay in" FontSize="22" FontAttributes="Bold" />
                        <Label Text=".NET" FontSize="22" FontAttributes="Bold" Margin="6,0,0,0"
                               TextColor="{AppThemeBinding Light={StaticResource DotNetBrandColor}, Dark={StaticResource DotNetBrandDarkColor}}" />
                        <Label Text="." FontSize="22" FontAttributes="Bold" />
                    </HorizontalStackLayout>
                    <Label x:Name="CounterLabel" Text="Clicked 0 times" FontSize="36" FontAttributes="Bold"
                           AutomationId="counter-label" />
                    <HorizontalStackLayout Spacing="12">
                        <!-- Leave colors unset so Fluent's neutral rest/hover/pressed tokens apply. -->
                        <Button Text="Increment" Clicked="OnIncrementClicked"
                                AutomationId="increment-button" />
                        <Button Text="Reset" Clicked="OnResetClicked" AutomationId="reset-button" />
                    </HorizontalStackLayout>
                    <Label Text="The buttons use MAUI's normal Clicked event. The handlers update a named Label — no JavaScript in the page's code-behind."
                              FontSize="14" TextColor="{DynamicResource Fluent.MutedColor}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="24" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Text input. Native interaction." FontSize="22" FontAttributes="Bold" />
                    <Label Text="A Fluent input sends text, focus and selection changes to ordinary MAUI events. The buttons below update it from C#."
                           FontSize="14" TextColor="{DynamicResource Fluent.MutedColor}" />
                    <Entry x:Name="DemoEntry" Placeholder="Type here — including 中文"
                           MaxLength="80" IsSpellCheckEnabled="False" ReturnType="Done" SemanticProperties.Description="Text interaction example"
                           TextChanged="OnEntryTextChanged" Completed="OnEntryCompleted"
                           Focused="OnEntryFocusChanged" Unfocused="OnEntryFocusChanged"
                           PropertyChanged="OnEntryPropertyChanged" AutomationId="demo-entry" />
                    <Label x:Name="InputStatusLabel" Text="Text: (empty)" FontSize="13" AutomationId="input-status" />
                    <Label x:Name="SelectionStatusLabel" Text="Selection: 0 + 0" FontSize="13" AutomationId="selection-status" />
                    <Label x:Name="FocusStatusLabel" Text="Focus: False" FontSize="13" AutomationId="focus-status" />
                    <Label x:Name="CompletedStatusLabel" Text="Completed: 0" FontSize="13" AutomationId="completed-status" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Set text" Clicked="OnSetInputClicked" AutomationId="input-set" />
                        <Button Text="Select" Clicked="OnSelectInputClicked" AutomationId="input-select" />
                        <Button Text="Clear" Clicked="OnClearInputClicked" AutomationId="input-clear" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Padding="24" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Animation. Driven by MAUI." FontSize="22" FontAttributes="Bold" />
                    <Label Text="Fade this panel with MAUI's animation API. The backend supplies browser frames; application code awaits the animation."
                           FontSize="14" TextColor="{DynamicResource Fluent.MutedColor}" />
                    <Border x:Name="AnimationPreview" Padding="16" StrokeShape="RoundRectangle 8" AutomationId="animation-preview">
                        <Label Text="One animation API, a browser-backed ticker." HorizontalTextAlignment="Center" />
                    </Border>
                    <Button Text="Animate" Clicked="OnAnimateClicked" HorizontalOptions="Start" AutomationId="animate" />
                    <Label x:Name="AnimationStatusLabel" Text="Animation: idle" FontSize="13" AutomationId="animation-status" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="24" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Scheduling. On the UI thread." FontSize="22" FontAttributes="Bold" />
                    <Label Text="A dispatcher timer updates the label five times, then stops. Start it again to restart the sequence."
                           FontSize="14" TextColor="{DynamicResource Fluent.MutedColor}" />
                    <Button Text="Start timer" Clicked="OnTimerClicked" HorizontalOptions="Start" AutomationId="timer-start" />
                    <Label x:Name="TimerStatusLabel" Text="Timer: stopped" FontSize="13" AutomationId="timer-status" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="24" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Layout. Updated at runtime." FontSize="22" FontAttributes="Bold" />
                    <Label Text="Add, move or remove MAUI views. The layout engine measures the updated content and the backend maintains DOM order."
                           FontSize="14" TextColor="{DynamicResource Fluent.MutedColor}" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Add" Clicked="OnAddItemClicked" AutomationId="item-add" />
                        <Button Text="Move" Clicked="OnMoveItemClicked" AutomationId="item-move" />
                        <Button Text="Remove" Clicked="OnRemoveItemClicked" AutomationId="item-remove" />
                    </HorizontalStackLayout>
                    <VerticalStackLayout x:Name="DynamicItems" Spacing="4" AutomationId="dynamic-items" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="8">
                <Label Text="One framework. Your application." FontSize="22" FontAttributes="Bold" />
                <Label Text="BrowserSample references a separate backend project. Change MainPage.xaml, publish, and open the result on an ordinary static server."
                      TextColor="{DynamicResource Fluent.MutedColor}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6">
                <Label x:Name="StartupLabel" Text="Startup: measuring…" FontSize="13"
                      TextColor="{DynamicResource Fluent.MutedColor}" AutomationId="startup-time" />
                <Label x:Name="WasmSizeLabel" Text="Wasm: measuring…" FontSize="13"
                      TextColor="{DynamicResource Fluent.MutedColor}" AutomationId="wasm-size" />
                <Label Text="Navigation to first MAUI frame opportunity · Wasm size before HTTP compression"
                      FontSize="12" TextColor="{DynamicResource Fluent.MutedColor}" />
                <Button Text="View source on GitHub ↗" Clicked="OnRepositoryClicked"
                        HorizontalOptions="Start" Margin="0,8,0,0" AutomationId="repository-link" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>