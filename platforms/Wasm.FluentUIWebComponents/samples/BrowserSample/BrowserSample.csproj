<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>FluentBrowserSample</AssemblyName>
    <RootNamespace>FluentBrowserSample</RootNamespace>
    <MauiBrowserAssetsDirectory>$(MSBuildProjectDirectory)/web</MauiBrowserAssetsDirectory>
    <SelfContained>true</SelfContained>
    <UseAppHost>false</UseAppHost>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- The compiler runs on the SDK host; browser-wasm remains the app target. -->
    <NuGetLockFilePath>packages.$(NETCoreSdkPortableRuntimeIdentifier).lock.json</NuGetLockFilePath>
    <!-- Publish and PackageSite share defaults regardless of the invoking shell. -->
    <SiteDirectory Condition="'$(SiteDirectory)' == '' and '$(PublishDir)' != ''">$(PublishDir)</SiteDirectory>
    <SiteDirectory Condition="'$(SiteDirectory)' == ''">$(MSBuildProjectDirectory)/artifacts/wwwroot</SiteDirectory>
    <PublishDir Condition="'$(PublishDir)' == ''">$(SiteDirectory)/</PublishDir>
    <SiteArchive Condition="'$(SiteArchive)' == ''">$(MSBuildProjectDirectory)/artifacts/BrowserSample-site.zip</SiteArchive>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Wasm.FluentUIWebComponents/Wasm.FluentUIWebComponents.csproj" />
    <PackageReference Include="Microsoft.DotNet.ILCompiler.LLVM" />
    <PackageReference Include="runtime.$(NETCoreSdkPortableRuntimeIdentifier).Microsoft.DotNet.ILCompiler.LLVM" />
    <MauiXaml Include="**/*.xaml" Exclude="$(DefaultItemExcludes)" Inflator="SourceGen" />
    <UnmanagedEntryPointsAssembly Include="Microsoft.Maui.Platforms.Wasm.FluentUIWebComponents" />
    <BrowserSampleTypeScript Include="web/**/*.ts" Exclude="web/**/*.d.ts" />
    <!-- Register outputs from source names, not an output glob: they need not exist on the first build. -->
    <BrowserSampleJavaScript Include="@(BrowserSampleTypeScript->'wwwroot/%(RecursiveDir)%(Filename).js')" />
    <WasmExtraFilesToDeploy Include="wwwroot/*" Exclude="@(BrowserSampleJavaScript)" />
    <WasmExtraFilesToDeploy Include="@(BrowserSampleJavaScript)" />
  </ItemGroup>
  <Import Project="../../src/Wasm.FluentUIWebComponents/buildTransitive/Microsoft.Maui.Platforms.Wasm.FluentUIWebComponents.targets" />
  <Target Name="BuildBrowserBootstrap" BeforeTargets="CoreCompile" DependsOnTargets="PrepareMauiBrowserAssets"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm run build" />
    <ItemGroup>
      <FileWrites Include="@(BrowserSampleJavaScript)" />
    </ItemGroup>
  </Target>
  <Target Name="PackageSite">
    <Error Condition="!Exists('$(SiteDirectory)')"
           Text="Published site not found at '$(SiteDirectory)'. Publish BrowserSample first, or set SiteDirectory to an existing collected site." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(SiteArchive)'))" />
    <ZipDirectory SourceDirectory="$(SiteDirectory)" DestinationFile="$(SiteArchive)" Overwrite="true" />
  </Target>
</Project>