{
    "name": "@maui-fluent-ui-web-component/browser-sample",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:maui-app && npm run build:ts && npm run build:site",
        "check": "tsc --project tsconfig.json --noEmit",
        "test": "node --test \"scripts/test/*.behaviour.test.mjs\"",
        "prepare:maui-bridge": "node scripts/prepare-maui-bridge.mjs",
        "build:maui-app": "dotnet publish BrowserSample.csproj",
        "build:ts": "npm run prepare:maui-bridge && tsc --project tsconfig.json",
        "build:site": "node scripts/build-site.mjs",
        "package:site": "dotnet msbuild BrowserSample.csproj -target:PackageSite"
    },
    "devDependencies": {
        "typescript": "5.9.3"
    },
    "engines": {
        "node": ">=22"
    }
}