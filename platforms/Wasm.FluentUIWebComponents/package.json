{
    "name": "maui-fluent-web-components-backend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node scripts/build-web.mjs",
        "check:sample": "tsc --project samples/BrowserSample/jsconfig.json",
        "publish:site": "dotnet publish samples/BrowserSample/BrowserSample.csproj",
        "package:site": "dotnet msbuild samples/BrowserSample/BrowserSample.csproj -target:PackageSite"
    },
    "dependencies": {
        "@fluentui/tokens": "1.0.0-alpha.24",
        "@fluentui/web-components": "3.1.3",
        "@microsoft/fast-element": "3.1.0",
        "@microsoft/focusgroup-polyfill": "1.6.0"
    },
    "devDependencies": {
        "esbuild": "0.28.2",
        "typescript": "5.9.3"
    },
    "engines": {
        "node": ">=22"
    }
}
