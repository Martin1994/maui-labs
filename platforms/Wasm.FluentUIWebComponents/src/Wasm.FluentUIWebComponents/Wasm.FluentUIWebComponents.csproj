<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.Maui.Platforms.Wasm.FluentUIWebComponents</AssemblyName>
    <RootNamespace>Microsoft.Maui.Platforms.Wasm.FluentUIWebComponents</RootNamespace>
        <!-- NativeAOT LLVM supplies its own toolchain, not the SDK's wasm-tools workload. -->
        <!-- See: https://github.com/dotnet/runtimelab/blob/527a565752062b20bb9693eea6c884b34ecce7bf/docs/using-nativeaot/compiling.md#adjust-the-project-configuration -->
        <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <BrowserBuildDirectory>$(MSBuildProjectDirectory)/obj/browser/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)</BrowserBuildDirectory>
    <!-- The host task owns its TFM and output layout, independently of the browser app. -->
    <_BrowserAssetTaskGlobalPropertiesToRemove>TargetFramework;TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishAot;PublishTrimmed;OutputType;BaseOutputPath;OutputPath;OutDir;BaseIntermediateOutputPath;IntermediateOutputPath;MSBuildProjectExtensionsPath;ProjectAssetsFile;PublishDir;AssemblyName;TargetName;MauiBrowserEnableAppAssets</_BrowserAssetTaskGlobalPropertiesToRemove>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <!-- Use the matching NativeAOT LLVM interop generator, not the SDK's Mono generator. -->
    <PackageReference Include="Microsoft.DotNet.ILCompiler.LLVM" PrivateAssets="all" />
    <ProjectReference Include="../../tools/Wasm.FluentUIWebComponents.CodeGen/Wasm.FluentUIWebComponents.CodeGen.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="BrowserCodeGenerator" Private="false" PrivateAssets="all" />
    <ProjectReference Include="../../tools/Wasm.FluentUIWebComponents.Assets/Wasm.FluentUIWebComponents.Assets.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="BrowserAssetTask" Private="false" PrivateAssets="all"
                      GlobalPropertiesToRemove="$(_BrowserAssetTaskGlobalPropertiesToRemove)" />
    <MauiBrowserAsset Include="$(BrowserBuildDirectory)/wwwroot/maui-browser.js;$(BrowserBuildDirectory)/wwwroot/maui-browser.d.ts;$(BrowserBuildDirectory)/wwwroot/dotnet.d.ts">
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </MauiBrowserAsset>
    <Content Include="@(MauiBrowserAsset)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Pack="true" PackagePath="browser-assets/" />
    <None Update="buildTransitive/Microsoft.Maui.Platforms.Wasm.FluentUIWebComponents.targets"
          Pack="true" PackagePath="buildTransitive/Microsoft.Maui.Platforms.Wasm.FluentUIWebComponents.targets" />
    <None Update="buildTransitive/MauiBrowser.AppAssets.targets" Pack="true" PackagePath="buildTransitive/MauiBrowser.AppAssets.targets" />
  </ItemGroup>
  <Target Name="CollectBrowserAssetTaskForPack" BeforeTargets="_GetPackageFiles"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IncludeContentInPack)' != 'false'">
    <!-- Query in the pack instance: no-build packing has no resolved build outputs here.
         GetTargetPath evaluates the tool project without restoring or building it. -->
    <MSBuild Projects="@(ProjectReference->WithMetadataValue('OutputItemType', 'BrowserAssetTask'))"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)"
             RemoveProperties="$(_BrowserAssetTaskGlobalPropertiesToRemove)">
      <Output TaskParameter="TargetOutputs" ItemName="_BrowserAssetTaskPackOutput" />
    </MSBuild>
    <Error Condition="'@(_BrowserAssetTaskPackOutput)' == ''"
           Text="Could not resolve the browser asset task output from its ProjectReference." />
    <Error Condition="!Exists('%(_BrowserAssetTaskPackOutput.Identity)')"
           Text="Browser asset task output is missing: %(_BrowserAssetTaskPackOutput.Identity). Build the backend for $(Configuration) before packing with --no-build." />
    <ItemGroup>
      <!-- This is the package layout consumed by UsingTask, not a source output path. -->
      <None Include="@(_BrowserAssetTaskPackOutput)" Pack="true"
            PackagePath="tools/net10.0/Wasm.FluentUIWebComponents.Assets.dll" Visible="false" />
    </ItemGroup>
  </Target>
  <!-- MSBuildWorkspace loads the project in design-time mode; it does not run this target recursively. -->
  <Target Name="GenerateBrowserInterop" DependsOnTargets="ResolveProjectReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <BrowserInteropDotNet Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</BrowserInteropDotNet>
      <BrowserInteropDotNet Condition="'$(BrowserInteropDotNet)' == ''">dotnet</BrowserInteropDotNet>
    </PropertyGroup>
    <Exec Command="&quot;$(BrowserInteropDotNet)&quot; &quot;@(BrowserCodeGenerator)&quot; &quot;$(MSBuildProjectFullPath)&quot; &quot;$(MSBuildProjectDirectory)/web/generated/contracts.g.ts&quot; --configuration &quot;$(Configuration)&quot;" />
    <!-- Shared generated source is intentionally not in configuration-specific FileWrites. -->
  </Target>
  <!-- Restored dependencies are shared by configurations and intentionally survive Clean. -->
  <Target Name="RestoreBrowserDependencies"
          Condition="'$(DesignTimeBuild)' != 'true' and !Exists('$(MSBuildProjectDirectory)/../../node_modules')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../.." Command="npm ci" />
  </Target>
  <Target Name="BuildBrowserAssets" BeforeTargets="CoreCompile" DependsOnTargets="RestoreBrowserDependencies;GenerateBrowserInterop"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../.." Command="npm run build"
          EnvironmentVariables="MAUI_BROWSER_PROJECT_ASSETS=$(ProjectAssetsFile);DOTNET_DECLARATIONS=;MAUI_BROWSER_INTEROP_GENERATED=1;MAUI_BROWSER_BUILD_DIRECTORY=$(BrowserBuildDirectory)" />
    <ItemGroup>
      <FileWrites Include="$(BrowserBuildDirectory)/**/*" />
    </ItemGroup>
  </Target>
  <!-- These outputs live outside the SDK's IntermediateOutputPath cleanup boundary. -->
  <Target Name="CleanBrowserAssets" AfterTargets="CoreClean" Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(BrowserBuildDirectory)" />
  </Target>
</Project>